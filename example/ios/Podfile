ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# truvideo-react-turbo-core-sdk is not on CocoaPods trunk; the camera podspec depends on it by name.
# Satisfy it from node_modules, a sibling git clone, TRUVIDEO_CORE_SDK_PATH, or a .truvideo-core-sdk-path file.
def truvideo_core_sdk_pod_root
  explicit = ENV['TRUVIDEO_CORE_SDK_PATH']
  return File.expand_path(explicit) if explicit && !explicit.strip.empty?

  ios_dir = __dir__
  pointer = File.expand_path('../.truvideo-core-sdk-path', ios_dir)
  if File.file?(pointer)
    from_file = File.read(pointer).strip
    unless from_file.empty?
      candidate = File.expand_path(from_file, File.dirname(pointer))
      return candidate if File.exist?(File.join(candidate, 'truvideo-react-turbo-core-sdk.podspec'))
    end
  end

  camera_repo_root = File.expand_path('../..', ios_dir)
  parent_of_camera = File.expand_path('..', camera_repo_root)

  candidates = [
    File.expand_path('../node_modules/@trunpm/truvideo-react-turbo-core-sdk', ios_dir),
    File.expand_path('../../node_modules/@trunpm/truvideo-react-turbo-core-sdk', ios_dir),
    File.expand_path('../../../node_modules/@trunpm/truvideo-react-turbo-core-sdk', ios_dir),
    File.join(parent_of_camera, 'TruVideoReactTurboCoreSdk'),
    File.join(parent_of_camera, 'truvideo-react-turbo-core-sdk'),
    File.join(camera_repo_root, 'TruVideoReactTurboCoreSdk'),
    File.join(camera_repo_root, 'truvideo-react-turbo-core-sdk'),
  ]

  candidates.find do |dir|
    next false unless Dir.exist?(dir)

    File.exist?(File.join(dir, 'truvideo-react-turbo-core-sdk.podspec'))
  end
end

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TruVideoReactTurboCameraSdkExample' do
  core_root = truvideo_core_sdk_pod_root
  unless core_root
    raise Pod::Informative, <<~MSG
      Missing native dependency `truvideo-react-turbo-core-sdk` (required by truvideo-react-turbo-camera-sdk).

      Pick one:
        • yarn add @trunpm/truvideo-react-turbo-core-sdk (from your private registry), from example/ then pod install
        • Clone the core SDK repo next to this repo (same parent folder as TruVideoReactTurboCameraSdk), then pod install
        • export TRUVIDEO_CORE_SDK_PATH=/path/to/folder/with/truvideo-react-turbo-core-sdk.podspec
        • echo /that/same/path > example/.truvideo-core-sdk-path (path can be relative to example/)
    MSG
  end
  pod 'truvideo-react-turbo-core-sdk', :path => core_root

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'TruVideoReactTurboCameraSdkExampleTests' do
    inherit! :complete
  end

  # 🔧 Pre-install (codegen)
  pre_install do |installer|
    system("cd ../../ && npx bob build --target codegen")
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      if target.name.include?('fmt')
        target.build_configurations.each do |build_config|

          defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defs = [defs] if defs.is_a?(String)

          unless defs.include?('FMT_USE_CONSTEVAL=0')
            defs << 'FMT_USE_CONSTEVAL=0'
          end

          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs

          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end